@{
    ViewData["Title"] = "Dashboard";
}

<div class="p-4 p-md-5 mb-4 bg-light rounded-3">
    <div class="container-fluid py-3">
        <h1 class="display-6 fw-bold">GeoGuide CMS MVP</h1>
        <p class="col-md-9 fs-5">
            Quan ly danh sach POI demo va cung cap API cho mobile app theo shared contract.
        </p>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary" asp-controller="PoisAdmin" asp-action="Index">Quan ly POI</a>
            <a class="btn btn-outline-secondary" href="/api/pois">GET /api/pois</a>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">API san sang</h2>
                <p class="mb-0">Bao gom <code>GET /api/pois</code>, <code>GET /api/pois/{id}</code> va <code>POST /api/logs/playback</code>.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Seed demo</h2>
                <p class="mb-0">Database duoc migrate va nap san 4 POI demo khi khoi dong app.</p>
            </div>
        </div>
    </div>
</div>
