<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             x:Class="MauiApp1.Pages.MainMapPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===== TOP HEADER BAR ===== -->
        <Border
            Grid.Row="0"
            BackgroundColor="#F8FAFC"
            StrokeThickness="0"
            Padding="0"
            ZIndex="50">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="24,16" ColumnSpacing="16">
                    <!-- Search icon -->
                    <Label
                        x:Name="SearchIcon"
                        Grid.Column="0"
                        Text="&#xe8b6;"
                        FontFamily="MaterialIcons"
                        FontSize="24"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSearchToggleTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Title -->
                    <Label
                        Grid.Column="1"
                        Text="The Sonic Lens"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource OnSurface}"
                        VerticalOptions="Center"/>

                    <!-- Settings icon -->
                    <Label
                        x:Name="SettingsIcon"
                        Grid.Column="2"
                        Text="&#xe429;"
                        FontFamily="MaterialIcons"
                        FontSize="24"
                        TextColor="{StaticResource Outline}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Divider -->
                <BoxView HeightRequest="1" Color="{StaticResource SurfaceDim}" Opacity="0.5"/>

                <Border
                    x:Name="SearchOverlay"
                    IsVisible="False"
                    BackgroundColor="#E6FFFFFF"
                    StrokeThickness="0"
                    Margin="24,0,24,12"
                    Padding="14,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label
                            Grid.Column="0"
                            Text="&#xe8b6;"
                            FontFamily="MaterialIcons"
                            FontSize="20"
                            TextColor="{StaticResource Outline}"
                            VerticalOptions="Center"/>
                        <Entry
                            x:Name="SearchEntry"
                            Grid.Column="1"
                            Placeholder="Tìm kiếm địa điểm gần đây"
                            ReturnType="Search"
                            Completed="OnSearchCompleted"
                            TextChanged="OnSearchTextChanged"
                            FontSize="14"
                            VerticalOptions="Center"/>
                        <Label
                            Grid.Column="2"
                            Text="&#xe5cd;"
                            FontFamily="MaterialIcons"
                            FontSize="20"
                            TextColor="{StaticResource Outline}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSearchCloseTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- ===== MAIN MAP AREA ===== -->
        <Grid Grid.Row="1" BackgroundColor="{StaticResource SurfaceContainerLow}">

            <!-- Mapsui OpenStreetMap Control -->
            <mapsui:MapControl x:Name="MapControl" />

            <Border
                x:Name="PoiUpdateBanner"
                IsVisible="False"
                BackgroundColor="#0F172A"
                StrokeThickness="0"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="20,14,20,0"
                Padding="14,10"
                ZIndex="350">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnApplyRefreshTapped"/>
                </Border.GestureRecognizers>
                <Label
                    x:Name="PoiUpdateBannerLabel"
                    Text="Da co ban cap nhat moi. Cham de lam moi"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="#F8FAFC"/>
            </Border>

            <Border
                x:Name="SystemStatusBanner"
                IsVisible="False"
                BackgroundColor="#FFF6E8"
                StrokeThickness="0"
                HorizontalOptions="Fill"
                VerticalOptions="Start"
                Margin="20,14,20,0"
                Padding="12,10"
                ZIndex="340">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Label
                    x:Name="SystemStatusLabel"
                    FontSize="12"
                    TextColor="#8A4B00"
                    LineBreakMode="WordWrap"/>
            </Border>

            <!-- ===== FLOATING ACTION BUTTON - Recenter ===== -->
            <Border
                x:Name="FabRecenter"
                WidthRequest="56"
                HeightRequest="56"
                BackgroundColor="#FFFFFF"
                StrokeThickness="0"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,24,260"
                ZIndex="300"
                InputTransparent="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRecenterTapped"/>
                </Border.GestureRecognizers>
                <Label
                    Text="&#xe55c;"
                    FontFamily="MaterialIcons"
                    FontSize="24"
                    TextColor="{StaticResource Primary}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
            </Border>

            <!-- ===== BOTTOM SHEET - Nearby Discoveries ===== -->
            <Border
                x:Name="BottomSheet"
                VerticalOptions="End"
                BackgroundColor="#F8FAFC"
                StrokeThickness="0"
                Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="32,32,0,0"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="0">
                    <!-- Handle Bar -->
                    <Border
                        WidthRequest="48"
                        HeightRequest="6"
                        BackgroundColor="{StaticResource Gray300}"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        Margin="0,12,0,20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="3"/>
                        </Border.StrokeShape>
                    </Border>

                    <!-- Title Row -->
                    <Grid ColumnDefinitions="*,Auto" Padding="24,0,24,16">
                        <Label
                            Grid.Column="0"
                            Text="Khám phá gần đây"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{StaticResource OnSurface}"/>
                        <Label
                            x:Name="RadiusLabel"
                            Grid.Column="1"
                            Text="BÁN KÍNH 1.5KM"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="End"/>
                    </Grid>

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="24,0,24,12">
                        <HorizontalStackLayout x:Name="CategoryChipContainer" Spacing="8" />
                    </ScrollView>

                    <!-- Discovery Cards List -->
                    <ScrollView HeightRequest="220" MaximumHeightRequest="260" Padding="24,0,24,24">
                        <VerticalStackLayout Spacing="12">
                            <ActivityIndicator x:Name="NearbyLoadingIndicator" IsVisible="False" IsRunning="False" HorizontalOptions="Center"/>
                            <Label x:Name="NearbyStatusLabel" IsVisible="False" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" HorizontalTextAlignment="Center"/>
                            <VerticalStackLayout x:Name="DiscoveryList" Spacing="12" />
                        </VerticalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ===== BOTTOM NAVIGATION BAR ===== -->
        <Border
            Grid.Row="2"
            BackgroundColor="#F8FAFC"
            StrokeThickness="0"
            Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24,24,0,0"/>
            </Border.StrokeShape>

            <Grid ColumnDefinitions="*,*,*,*" Padding="16,12,16,24">
                <!-- Explore (Active) -->
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                    <Label
                        Text="&#xe87a;"
                        FontFamily="MaterialIcons"
                        FontSize="24"
                        TextColor="{StaticResource Primary}"
                        HorizontalTextAlignment="Center"/>
                    <Label
                        Text="KHÁM PHÁ"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}"
                        HorizontalTextAlignment="Center"
                        CharacterSpacing="0.5"/>
                </VerticalStackLayout>

                <!-- Favorites -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <Label
                        Text="&#xe87d;"
                        FontFamily="MaterialIcons"
                        FontSize="24"
                        TextColor="{StaticResource Outline}"
                        HorizontalTextAlignment="Center"/>
                    <Label
                        Text="YÊU THÍCH"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Outline}"
                        HorizontalTextAlignment="Center"
                        CharacterSpacing="0.5"/>
                </VerticalStackLayout>

                <!-- History -->
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                    <Label
                        Text="&#xe889;"
                        FontFamily="MaterialIcons"
                        FontSize="24"
                        TextColor="{StaticResource Outline}"
                        HorizontalTextAlignment="Center"/>
                    <Label
                        Text="LỊCH SỬ"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Outline}"
                        HorizontalTextAlignment="Center"
                        CharacterSpacing="0.5"/>
                </VerticalStackLayout>

                <!-- Profile -->
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="4">
                    <Label
                        Text="&#xe7fd;"
                        FontFamily="MaterialIcons"
                        FontSize="24"
                        TextColor="{StaticResource Outline}"
                        HorizontalTextAlignment="Center"/>
                    <Label
                        Text="CÁ NHÂN"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Outline}"
                        HorizontalTextAlignment="Center"
                        CharacterSpacing="0.5"/>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>

</ContentPage>
