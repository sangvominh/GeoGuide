<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Pages.SplashPermissionPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <Grid>
        <!-- Background Gradient -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#D8E2FF" Offset="0.0"/>
                    <GradientStop Color="#FAF9FE" Offset="0.5"/>
                    <GradientStop Color="#FAF9FE" Offset="1.0"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Main Splash Content -->
        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="0"
            Padding="24,0">

            <!-- Logo Icon -->
            <Border
                x:Name="LogoIcon"
                WidthRequest="96"
                HeightRequest="96"
                BackgroundColor="{StaticResource PrimaryContainer}"
                HorizontalOptions="Center"
                Margin="0,0,0,24"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="16" Opacity="0.15"/>
                </Border.Shadow>
                <Label
                    Text="&#xf71d;"
                    FontFamily="MaterialIcons"
                    FontSize="48"
                    TextColor="{StaticResource OnPrimaryContainer}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
            </Border>

            <!-- App Title -->
            <Label
                x:Name="AppTitle"
                Text="The Sonic Lens"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="{StaticResource OnSurface}"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,8"/>

            <!-- Subtitle -->
            <Label
                x:Name="AppSubtitle"
                Text="Audio-first urban exploration"
                FontSize="16"
                TextColor="{StaticResource OnSurfaceVariant}"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,48"/>

            <Border
                x:Name="ReturningUserPanel"
                IsVisible="False"
                BackgroundColor="{StaticResource SurfaceContainerLow}"
                Padding="18,14"
                StrokeThickness="0"
                HorizontalOptions="Fill"
                Margin="0,0,0,16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label
                        x:Name="ReturningTitle"
                        Text="What's new"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource OnSurface}"/>
                    <Label
                        x:Name="ReturningMessage"
                        Text="Fresh nearby POIs and audio updates are ready."
                        FontSize="13"
                        TextColor="{StaticResource OnSurfaceVariant}"/>
                </VerticalStackLayout>
            </Border>

            <!-- First-run language selector -->
            <Border
                x:Name="LanguageSelectionPanel"
                BackgroundColor="{StaticResource SurfaceContainerLow}"
                Padding="16"
                StrokeThickness="0"
                HorizontalOptions="Fill"
                Margin="0,0,0,16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label
                        x:Name="LanguageSelectorTitle"
                        Text="Choose language"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource OnSurface}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button
                            x:Name="EnglishOptionButton"
                            Grid.Column="0"
                            Text="English (US)"
                            Clicked="OnLanguageOptionClicked"
                            CommandParameter="en-US" />
                        <Button
                            x:Name="VietnameseOptionButton"
                            Grid.Column="1"
                            Text="Tiếng Việt"
                            Clicked="OnLanguageOptionClicked"
                            CommandParameter="vi-VN" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border
                x:Name="SkeletonPanel"
                IsVisible="False"
                Opacity="0"
                BackgroundColor="{StaticResource SurfaceContainerHighest}"
                Padding="20,16"
                StrokeThickness="0"
                HorizontalOptions="Fill"
                Margin="0,0,0,16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <BoxView HeightRequest="12" WidthRequest="140" Color="{StaticResource SurfaceContainerHigh}"/>
                    <BoxView HeightRequest="10" WidthRequest="220" Color="{StaticResource SurfaceContainerHigh}"/>
                    <BoxView HeightRequest="10" WidthRequest="190" Color="{StaticResource SurfaceContainerHigh}"/>
                </VerticalStackLayout>
            </Border>

            <Label
                x:Name="ProgressLabel"
                Text=""
                FontSize="12"
                TextColor="{StaticResource OnSurfaceVariant}"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,12"/>

            <Button
                x:Name="ContinueButton"
                Text="Continue"
                IsEnabled="False"
                FontSize="16"
                FontAttributes="Bold"
                HorizontalOptions="Fill"
                Margin="0,0,0,96"
                Clicked="OnContinueClicked" />
        </VerticalStackLayout>

        <!-- Footer -->
        <Label
            x:Name="FooterLabel"
            Text="INITIALIZING NARRATIVE ENGINE"
            FontSize="11"
            FontAttributes="Bold"
            TextColor="{StaticResource OutlineVariant}"
            HorizontalTextAlignment="Center"
            CharacterSpacing="2"
            VerticalOptions="End"
            Margin="0,0,0,40"/>
    </Grid>

</ContentPage>
