<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Pages.SplashPermissionPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <Grid>
        <!-- Background Gradient -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#D8E2FF" Offset="0.0"/>
                    <GradientStop Color="#FAF9FE" Offset="0.5"/>
                    <GradientStop Color="#FAF9FE" Offset="1.0"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Main Splash Content -->
        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="0"
            Padding="24,0">

            <!-- App Title -->
            <Label
                x:Name="AppTitle"
                Text="Ống Kính Âm Thanh"
                FontSize="32"
                FontAttributes="Bold"
                TextColor="{StaticResource OnSurface}"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,28"/>

            <Border
                x:Name="ReturningUserPanel"
                IsVisible="False"
                BackgroundColor="{StaticResource SurfaceContainerLow}"
                Padding="18,14"
                StrokeThickness="0"
                HorizontalOptions="Fill"
                Margin="0,0,0,16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label
                        x:Name="ReturningTitle"
                        Text="Có gì mới"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{StaticResource OnSurface}"/>
                    <Label
                        x:Name="ReturningMessage"
                        Text="Nội dung cập nhật cho phiên bản mới sẽ hiển thị tại đây."
                        FontSize="13"
                        TextColor="{StaticResource OnSurfaceVariant}"/>
                </VerticalStackLayout>
            </Border>

            <!-- First-run language selector -->
            <Border
                x:Name="LanguageSelectionPanel"
                BackgroundColor="{StaticResource SurfaceContainerLow}"
                Padding="16"
                StrokeThickness="0"
                HorizontalOptions="Fill"
                Margin="0,0,0,16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label
                        x:Name="LanguageSelectorTitle"
                        Text="Chọn ngôn ngữ"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource OnSurface}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button
                            x:Name="EnglishOptionButton"
                            Grid.Column="0"
                            Text="Tiếng Anh (Mỹ)"
                            Clicked="OnLanguageOptionClicked"
                            CommandParameter="en-US" />
                        <Button
                            x:Name="VietnameseOptionButton"
                            Grid.Column="1"
                            Text="Tiếng Việt"
                            Clicked="OnLanguageOptionClicked"
                            CommandParameter="vi-VN" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border
                x:Name="SkeletonPanel"
                IsVisible="False"
                Opacity="0"
                BackgroundColor="{StaticResource SurfaceContainerHighest}"
                Padding="20,16"
                StrokeThickness="0"
                HorizontalOptions="Fill"
                Margin="0,0,0,16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <BoxView HeightRequest="12" WidthRequest="140" Color="{StaticResource SurfaceContainerHigh}"/>
                    <BoxView HeightRequest="10" WidthRequest="220" Color="{StaticResource SurfaceContainerHigh}"/>
                    <BoxView HeightRequest="10" WidthRequest="190" Color="{StaticResource SurfaceContainerHigh}"/>
                </VerticalStackLayout>
            </Border>

            <Label
                x:Name="ProgressLabel"
                Text=""
                FontSize="12"
                TextColor="{StaticResource OnSurfaceVariant}"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,12"/>

            <Button
                x:Name="ContinueButton"
                Text="Tiếp tục"
                IsEnabled="False"
                FontSize="16"
                FontAttributes="Bold"
                HorizontalOptions="Fill"
                Margin="0,0,0,12"
                Clicked="OnContinueClicked" />

            <HorizontalStackLayout
                x:Name="NavigationLoadingPanel"
                IsVisible="False"
                HorizontalOptions="Center"
                Spacing="8"
                Margin="0,0,0,84">
                <ActivityIndicator
                    x:Name="NavigationLoadingIndicator"
                    IsRunning="False"
                    Color="{StaticResource Primary}" />
                <Label
                    x:Name="NavigationLoadingLabel"
                    Text="Đang mở bản đồ..."
                    FontSize="13"
                    TextColor="{StaticResource OnSurfaceVariant}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Footer -->
        <Label
            x:Name="FooterLabel"
            Text="ĐANG KHỞI ĐỘNG HỆ THỐNG KỂ CHUYỆN"
            FontSize="11"
            FontAttributes="Bold"
            TextColor="{StaticResource OutlineVariant}"
            HorizontalTextAlignment="Center"
            CharacterSpacing="2"
            VerticalOptions="End"
            Margin="0,0,0,40"/>
    </Grid>

</ContentPage>
