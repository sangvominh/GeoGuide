<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             x:Class="MauiApp1.Pages.MainMapPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto">

        <!-- ===== TOP HEADER BAR ===== -->
        <Border
            x:Name="HeaderBar"
            Grid.Row="0"
            BackgroundColor="#F8FAFC"
            StrokeThickness="0"
            Padding="0"
            ZIndex="50">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="24,16" ColumnSpacing="16">
                    <!-- Search icon -->
                    <Label
                        x:Name="SearchIcon"
                        Grid.Column="0"
                        Text="&#xe8b6;"
                        FontFamily="MaterialIcons"
                        FontSize="24"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSearchToggleTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Title -->
                    <Label
                        Grid.Column="1"
                        Text="Ống Kính Âm Thanh"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource OnSurface}"
                        VerticalOptions="Center"/>

                    <!-- Settings icon -->
                    <Label
                        x:Name="SettingsIcon"
                        Grid.Column="2"
                        Text="&#xe429;"
                        FontFamily="MaterialIcons"
                        FontSize="24"
                        TextColor="{StaticResource Outline}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingsTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Divider -->
                <BoxView HeightRequest="1" Color="{StaticResource SurfaceDim}" Opacity="0.5"/>

                <Border
                    x:Name="SearchOverlay"
                    IsVisible="False"
                    BackgroundColor="#E6FFFFFF"
                    StrokeThickness="0"
                    Margin="24,0,24,12"
                    Padding="14,8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label
                            Grid.Column="0"
                            Text="&#xe8b6;"
                            FontFamily="MaterialIcons"
                            FontSize="20"
                            TextColor="{StaticResource Outline}"
                            VerticalOptions="Center"/>
                        <Entry
                            x:Name="SearchEntry"
                            Grid.Column="1"
                            Placeholder="Tìm kiếm địa điểm gần đây"
                            ReturnType="Search"
                            Completed="OnSearchCompleted"
                            TextChanged="OnSearchTextChanged"
                            FontSize="14"
                            VerticalOptions="Center"/>
                        <Label
                            Grid.Column="2"
                            Text="&#xe5cd;"
                            FontFamily="MaterialIcons"
                            FontSize="20"
                            TextColor="{StaticResource Outline}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSearchCloseTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid x:Name="MainContentGrid" Grid.Row="1" RowDefinitions="*,3*" BackgroundColor="{StaticResource SurfaceContainerLow}">
            <Grid Grid.Row="0" Padding="16,12,16,8">
                <Border
                    x:Name="CompactMapHost"
                    BackgroundColor="#FFFFFF"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <mapsui:MapControl x:Name="MapControl"/>
                </Border>

                <Border
                    x:Name="FabRecenter"
                    WidthRequest="52"
                    HeightRequest="52"
                    BackgroundColor="#FFFFFF"
                    StrokeThickness="0"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,24,22"
                    ZIndex="200">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRecenterTapped"/>
                    </Border.GestureRecognizers>
                    <Label
                        Text="&#xe55c;"
                        FontFamily="MaterialIcons"
                        FontSize="22"
                        TextColor="{StaticResource Primary}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
                </Border>

                <Border
                    WidthRequest="52"
                    HeightRequest="52"
                    BackgroundColor="#FFFFFF"
                    StrokeThickness="0"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    Margin="0,20,24,0"
                    ZIndex="200">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExpandMapTapped"/>
                    </Border.GestureRecognizers>
                    <Label
                        Text="&#xe5d0;"
                        FontFamily="MaterialIcons"
                        FontSize="22"
                        TextColor="{StaticResource Primary}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
                </Border>
            </Grid>

            <Border Grid.Row="1" Margin="16,8,16,16" BackgroundColor="#F8FAFC" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="0" Padding="20,18,20,20">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label
                                Text="Điểm thuyết minh lân cận"
                                FontSize="20"
                                FontAttributes="Bold"
                                TextColor="{StaticResource OnSurface}"/>
                            <Label
                                x:Name="NearestPoiLabel"
                                Text="Đang tìm POI gần nhất..."
                                FontSize="12"
                                TextColor="{StaticResource OnSurfaceVariant}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                            <Label
                                x:Name="RadiusLabel"
                                Text="BÁN KÍNH 1.5KM"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="{StaticResource Primary}"
                                HorizontalTextAlignment="End"
                                VerticalOptions="End"/>
                            <Label
                                x:Name="DataSourceLabel"
                                Text="Nguồn: chờ tải"
                                FontSize="11"
                                TextColor="{StaticResource OnSurfaceVariant}"
                                HorizontalTextAlignment="End"/>
                        </VerticalStackLayout>
                    </Grid>

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="0,0,0,10">
                        <HorizontalStackLayout x:Name="CategoryChipContainer" Spacing="8" />
                    </ScrollView>

                    <ScrollView Padding="0,0,0,0">
                        <VerticalStackLayout Spacing="12">
                            <ActivityIndicator x:Name="NearbyLoadingIndicator" IsVisible="False" IsRunning="False" HorizontalOptions="Center"/>
                            <Label x:Name="NearbyStatusLabel" IsVisible="False" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" HorizontalTextAlignment="Center"/>
                            <VerticalStackLayout x:Name="DiscoveryList" Spacing="12" />
                        </VerticalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ===== BOTTOM NAVIGATION BAR ===== -->
        <Border
            x:Name="BottomNavBar"
            Grid.Row="2"
            BackgroundColor="#F8FAFC"
            StrokeThickness="0"
            Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24,24,0,0"/>
            </Border.StrokeShape>

            <Grid ColumnDefinitions="*,*,*,*" Padding="16,12,16,24">
                <!-- Explore (Active) -->
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                    <Label
                        Text="&#xe87a;"
                        FontFamily="MaterialIcons"
                        FontSize="24"
                        TextColor="{StaticResource Primary}"
                        HorizontalTextAlignment="Center"/>
                    <Label
                        Text="KHÁM PHÁ"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}"
                        HorizontalTextAlignment="Center"
                        CharacterSpacing="0.5"/>
                </VerticalStackLayout>

                <!-- Favorites -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <Label
                        Text="&#xe87d;"
                        FontFamily="MaterialIcons"
                        FontSize="24"
                        TextColor="{StaticResource Outline}"
                        HorizontalTextAlignment="Center"/>
                    <Label
                        Text="YÊU THÍCH"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Outline}"
                        HorizontalTextAlignment="Center"
                        CharacterSpacing="0.5"/>
                </VerticalStackLayout>

                <!-- History -->
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                    <Label
                        Text="&#xe889;"
                        FontFamily="MaterialIcons"
                        FontSize="24"
                        TextColor="{StaticResource Outline}"
                        HorizontalTextAlignment="Center"/>
                    <Label
                        Text="LỊCH SỬ"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Outline}"
                        HorizontalTextAlignment="Center"
                        CharacterSpacing="0.5"/>
                </VerticalStackLayout>

                <!-- Profile -->
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="4">
                    <Label
                        Text="&#xe7fd;"
                        FontFamily="MaterialIcons"
                        FontSize="24"
                        TextColor="{StaticResource Outline}"
                        HorizontalTextAlignment="Center"/>
                    <Label
                        Text="CÁ NHÂN"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Outline}"
                        HorizontalTextAlignment="Center"
                        CharacterSpacing="0.5"/>
                </VerticalStackLayout>
            </Grid>
        </Border>
        <!-- ===== FULLSCREEN MAP OVERLAY ===== -->
        <Grid x:Name="FullScreenOverlay" Grid.RowSpan="3" IsVisible="False" ZIndex="999" BackgroundColor="#F8FAFC">
            <Border
                x:Name="FullScreenMapHost"
                Margin="0"
                BackgroundColor="#FFFFFF"
                StrokeThickness="0"/>

            <Grid Padding="18,24" RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*">
                <Border
                    WidthRequest="52"
                    HeightRequest="52"
                    BackgroundColor="#FFFFFF"
                    StrokeThickness="0"
                    HorizontalOptions="Start"
                    VerticalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExitFullscreenTapped"/>
                    </Border.GestureRecognizers>
                    <Label
                        Text="&#xe5c4;"
                        FontFamily="MaterialIcons"
                        FontSize="24"
                        TextColor="{StaticResource Primary}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
                </Border>

                <Border
                    Grid.Row="2"
                    Grid.Column="1"
                    WidthRequest="52"
                    HeightRequest="52"
                    BackgroundColor="#FFFFFF"
                    StrokeThickness="0"
                    HorizontalOptions="End"
                    VerticalOptions="End">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="26"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRecenterTapped"/>
                    </Border.GestureRecognizers>
                    <Label
                        Text="&#xe55c;"
                        FontFamily="MaterialIcons"
                        FontSize="22"
                        TextColor="{StaticResource Primary}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>

</ContentPage>
