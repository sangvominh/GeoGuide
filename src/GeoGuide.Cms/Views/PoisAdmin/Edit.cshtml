@model GeoGuide.Cms.Models.Poi

@{
    ViewData["Title"] = "Edit POI";
    var isSystemAdmin = ViewBag.IsSystemAdmin is bool value && value;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Edit POI</h1>
        @if (!isSystemAdmin)
        {
            <p class="text-muted mb-0">Tenant chi duoc sua POI dang o trang thai cho duyet.</p>
        }
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</div>

<form asp-action="Edit" method="post" class="card shadow-sm p-4">
    <input asp-for="Id" type="hidden" />
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Update</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
