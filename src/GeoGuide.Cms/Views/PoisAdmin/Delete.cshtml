@model GeoGuide.Cms.Models.Poi

@{
    ViewData["Title"] = "Xóa POI";
}

<div class="card shadow-sm">
    <div class="card-body p-4">
        <h1 class="h3">Xóa POI</h1>
        <p class="mb-4">Xóa <strong>@Model.Name</strong> khỏi danh sách demo?</p>

        <dl class="row">
            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.CategoryLabel</dd>
            <dt class="col-sm-3">Tọa độ</dt>
            <dd class="col-sm-9">@Model.Latitude, @Model.Longitude</dd>
            <dt class="col-sm-3">Kích hoạt</dt>
            <dd class="col-sm-9">@Model.IsActive</dd>
        </dl>

        <form asp-action="Delete" method="post" class="d-flex gap-2">
            <input asp-for="Id" type="hidden" />
            <button type="submit" class="btn btn-danger">Xóa</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
        </form>
    </div>
</div>
