@model GeoGuide.Cms.Models.Poi

@{
    var isSystemAdmin = ViewBag.IsSystemAdmin is bool value && value;
    ViewData["Title"] = isSystemAdmin ? "Create POI" : "Register POI";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">@(isSystemAdmin ? "Create POI" : "Register POI")</h1>
        @if (!isSystemAdmin)
        {
            <p class="text-muted mb-0">POI moi se vao hang cho duyet truoc khi hien thi cho admin va API.</p>
        }
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</div>

<form asp-action="Create" method="post" class="card shadow-sm p-4">
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@(isSystemAdmin ? "Save" : "Gui duyet")</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
