@model GeoGuide.Cms.Models.PoisAdminIndexViewModel

@{
    ViewData["Title"] = "POIs";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">POI Management</h1>
        <p class="text-muted mb-0">
            @(Model.IsSystemAdmin
                ? "Admin có thể lọc theo tenant và duyệt POI cho đối tác."
                : "Tenant đăng ký POI mới và theo dõi trạng thái phê duyệt trong phạm vi của mình.")
        </p>
    </div>
    <a class="btn btn-primary" asp-action="Create">@(Model.IsSystemAdmin ? "Tạo POI" : "Đăng ký POI")</a>
</div>

@if (Model.IsSystemAdmin)
{
    <form method="get" class="card shadow-sm mb-3 p-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label for="tenantId" class="form-label mb-1">Xem theo tenant</label>
                <select id="tenantId" name="tenantId" asp-items="Model.TenantOptions" class="form-select"></select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-outline-primary">Lọc</button>
            </div>
        </div>
    </form>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Tenant</th>
                    <th>Phê duyệt</th>
                    <th>Category</th>
                    <th>Coordinates</th>
                    <th>Radius</th>
                    <th>Status</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var poi in Model.Pois)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@poi.Name</div>
                            <div class="small text-muted">Priority @poi.Priority</div>
                        </td>
                        <td>@(poi.Tenant?.Name ?? "System")</td>
                        <td>
                            @if (poi.ApprovalStatus == GeoGuide.Cms.Models.PoiApprovalStatus.Approved)
                            {
                                <span class="badge text-bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">Pending</span>
                            }
                        </td>
                        <td>@poi.CategoryLabel</td>
                        <td>@poi.Latitude.ToString("F4"), @poi.Longitude.ToString("F4")</td>
                        <td>@poi.TriggerRadiusMeters m</td>
                        <td>
                            @if (poi.IsActive)
                            {
                                <span class="badge text-bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>@poi.UpdatedAt.ToUniversalTime().ToString("u")</td>
                        <td class="text-end">
                            @if (Model.IsSystemAdmin)
                            {
                                @if (poi.ApprovalStatus == GeoGuide.Cms.Models.PoiApprovalStatus.PendingApproval)
                                {
                                    <form asp-action="Approve" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@poi.Id" />
                                        <input type="hidden" name="tenantId" value="@Model.SelectedTenantId" />
                                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                    </form>
                                }
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@poi.Id">Edit</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@poi.Id">Delete</a>
                            }
                            else if (poi.ApprovalStatus == GeoGuide.Cms.Models.PoiApprovalStatus.PendingApproval)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@poi.Id">Edit</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@poi.Id">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
