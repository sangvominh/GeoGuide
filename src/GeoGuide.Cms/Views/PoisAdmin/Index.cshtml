@model IReadOnlyList<GeoGuide.Cms.Models.Poi>

@{
    ViewData["Title"] = "POIs";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">POI Management</h1>
        <p class="text-muted mb-0">Quan ly CRUD cho cac diem den phuc vu demo mobile.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Tao POI</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Coordinates</th>
                    <th>Radius</th>
                    <th>Status</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var poi in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@poi.Name</div>
                            <div class="small text-muted">Priority @poi.Priority</div>
                        </td>
                        <td>@poi.CategoryLabel</td>
                        <td>@poi.Latitude.ToString("F4"), @poi.Longitude.ToString("F4")</td>
                        <td>@poi.TriggerRadiusMeters m</td>
                        <td>
                            @if (poi.IsActive)
                            {
                                <span class="badge text-bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>@poi.UpdatedAt.ToUniversalTime().ToString("u")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@poi.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@poi.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
