@using GeoGuide.Cms.Models
@using GeoGuide.Cms.Security
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GeoGuide CMS</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GeoGuide.Cms.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">GeoGuide</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var isAdmin = User.IsInRole(CmsRoles.SystemAdmin);
                            var isSeller = User.IsInRole(CmsRoles.PoiTenant);

                            @if (isAdmin)
                            {
                                <li class="nav-item">
                                    <span class="nav-link disabled text-uppercase small text-white-50">Admin</span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="PoisAdmin" asp-action="Index">POIs</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="AdminReview" asp-action="Index">Review</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="ToursAdmin" asp-action="Index">Tours</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="AnalyticsAdmin" asp-action="Index">Analytics</a>
                                </li>
                            }

                            @if (isSeller && !isAdmin)
                            {
                                <li class="nav-item">
                                    <span class="nav-link disabled text-uppercase small text-white-50">Seller</span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="OwnerPortal" asp-action="Index">My Portal</a>
                                </li>
                            }
                            else if (isAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="OwnerPortal" asp-action="Index">Seller Portal</a>
                                </li>
                            }

                            @if (isAdmin)
                            {
                                <li class="nav-item">
                                    <span class="nav-link disabled text-uppercase small text-white-50">Tools</span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="ReferenceConsole" asp-action="Index">Workflow</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="AiAdvisor" asp-action="Index">AI Advisor</a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="OwnerPortal" asp-action="Register">Register Seller</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var currentUser = await UserManager.GetUserAsync(User);
                            <span class="navbar-text text-white small">
                                @(currentUser?.DisplayName ?? User.Identity?.Name)
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-light btn-sm">Đăng xuất</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - GeoGuide CMS MVP
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
