@model GeoGuide.Cms.Models.PoiAudio

@{
    ViewData["Title"] = "Xoa noi dung POI";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="h4 mb-3">Xoa noi dung POI</h1>
        <p>Ban co chac chan muon xoa noi dung <strong>@Model.LanguageCode - @Model.ContentType</strong> khong?</p>
        <form asp-action="Delete" method="post" class="d-flex gap-2">
            <input asp-for="Id" type="hidden" />
            <button type="submit" class="btn btn-danger">Xoa</button>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-poiId="@Model.PoiId">Huy</a>
        </form>
    </div>
</div>
