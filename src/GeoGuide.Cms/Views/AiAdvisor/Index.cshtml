@model GeoGuide.Cms.Models.AiAdvisor.AiAdvisorViewModel

@{
    ViewData["Title"] = "AI Advisor";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-magic text-primary"></i> AI Advisor</h1>
    </div>
    
    <p class="lead">Enhance your Point of Interest descriptions using AI.</p>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">Original Details</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Index" method="post">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. The Grand Hotel" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Category" class="form-label fw-bold"></label>
                                <input asp-for="Category" class="form-control" placeholder="e.g. Hotel, Restaurant" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="PriceRange" class="form-label fw-bold"></label>
                                <input asp-for="PriceRange" class="form-control" placeholder="e.g. $$$, Luxury" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-bold"></label>
                            <input asp-for="Address" class="form-control" placeholder="123 Main St" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="6" placeholder="Current basic description..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mt-2">
                            <i class="bi bi-stars"></i> Enhance Description
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Enhanced Result</h5>
                    @if (Model.IsEnhanced && !string.IsNullOrEmpty(Model.Provider))
                    {
                        <span class="badge bg-info">Provider: @Model.Provider</span>
                    }
                </div>
                <div class="card-body d-flex flex-column">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i> @Model.ErrorMessage
                        </div>
                    }

                    @if (Model.IsEnhanced)
                    {
                        @if (Model.Provider != null && Model.Provider.Contains("Local Demo", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="alert alert-warning py-2 mb-3">
                                <small><i class="bi bi-info-circle"></i> Note: This result is generated by the local demo fallback provider. Configure a valid API key for production AI results.</small>
                            </div>
                        }

                        <div class="form-group flex-grow-1 mb-3">
                            <textarea id="enhancedOutput" class="form-control h-100 min-vh-25" style="min-height: 250px;" readonly>@Model.EnhancedDescription</textarea>
                        </div>
                        
                        <div class="mt-auto">
                            <button type="button" class="btn btn-outline-secondary w-100" onclick="copyEnhancedText()">
                                <i class="bi bi-clipboard"></i> Copy to Clipboard
                            </button>
                        </div>
                    }
                    else if (string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="text-center text-muted my-auto py-5">
                            <i class="bi bi-robot" style="font-size: 3rem;"></i>
                            <p class="mt-3">Fill out the details on the left and click "Enhance Description" to see the AI magic.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function copyEnhancedText() {
            var copyText = document.getElementById("enhancedOutput");
            copyText.select();
            copyText.setSelectionRange(0, 99999); // For mobile devices
            navigator.clipboard.writeText(copyText.value).then(function() {
                // Could add a small toast here if toastr or similar is available.
                // Simple alert for now.
                alert("Copied to clipboard!");
            }, function() {
                alert("Failed to copy text.");
            });
        }
    </script>
}
