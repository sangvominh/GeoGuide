@model GeoGuide.Cms.Models.QrSessionAdminViewModel
@{
    ViewData["Title"] = "QR Session";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">QR Session</h1>
        <p class="text-muted mb-0">QR công khai dùng chung cho toàn bộ thiết bị mới. Session mặc định sẽ được giữ cố định nếu bạn không đổi thủ công.</p>
    </div>
    <form method="get" class="d-flex gap-2 align-items-end">
        <div>
            <label class="form-label small mb-1">Session</label>
            <input class="form-control form-control-sm" type="text" name="sessionToken" value="@Model.SessionToken" />
        </div>
        <div>
            <label class="form-label small mb-1">Quyền</label>
            <select class="form-select form-select-sm" name="accessMode">
                @if (Model.AccessMode == "full")
                {
                    <option value="full" selected>Full</option>
                    <option value="trial">Trial</option>
                }
                else
                {
                    <option value="full">Full</option>
                    <option value="trial" selected>Trial</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label small mb-1">Public Base URL</label>
            <input class="form-control form-control-sm" type="text" name="publicBaseUrl" value="@Model.PublicBaseUrl" placeholder="http://192.168.1.10:5005" />
        </div>
        <button class="btn btn-primary btn-sm" type="submit">Tạo QR</button>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h2 class="h6 mb-0">Mã QR công khai</h2>
            </div>
            <div class="card-body text-center">
                <img src="@Model.QrImageUrl" alt="QR Session" class="img-fluid rounded border" style="max-width:280px;" />
                <div class="mt-3">
                    <div class="text-muted small">Join URL</div>
                    <code class="d-block">@Model.JoinUrl</code>
                </div>
                <div class="mt-2 text-muted small">
                    Người dùng mới quét mã này bằng camera mặc định sẽ vào landing page, sau đó mở app hoặc tải APK. Thiết bị và log sẽ tiếp tục bám vào đúng session đang hiển thị ở đây.
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h2 class="h6 mb-0">Theo dõi nhanh</h2>
            </div>
            <div class="card-body">
                <div class="mb-2"><strong>Session:</strong> <code>@Model.SessionToken</code></div>
                <div class="mb-2"><strong>Access mode:</strong> @Model.AccessMode</div>
                <div class="mb-2"><strong>Deep link:</strong> <code>@Model.DeepLinkUrl</code></div>
                <div class="mb-2"><strong>APK Android:</strong> <code>@Model.AndroidApkUrl</code></div>
                <div class="mb-3">
                    <a class="btn btn-outline-secondary btn-sm" href="@Model.JoinUrl" target="_blank">Mở landing page</a>
                    <a class="btn btn-outline-secondary btn-sm" href="/AnalyticsAdmin?sessionToken=@Model.SessionToken">Mở analytics theo session</a>
                    <a class="btn btn-outline-secondary btn-sm" href="/api/v1/analytics/sessions/@Model.SessionToken/devices">JSON devices</a>
                </div>
                <div class="text-muted small">
                    QR hiện trỏ tới landing page công khai. Landing page sẽ thử mở app bằng deep link <code>geoguide://join?... </code>, nếu máy chưa có app thì cho tải APK Android.
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h2 class="h6 mb-0">Thiết bị đã join session</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>Thiết bị</th>
                <th>Client</th>
                <th>Quyền</th>
                <th>Tham gia</th>
                <th>Lần cuối</th>
                <th class="text-end">Lượt nghe</th>
                <th class="text-end">Tổng giây</th>
                <th>POI gần nhất</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Devices.Count == 0)
            {
                <tr><td colspan="8" class="text-muted">Chưa có thiết bị nào join session này.</td></tr>
            }
            else
            {
                @foreach (var row in Model.Devices)
                {
                    <tr>
                        <td class="font-monospace">@row.DeviceId</td>
                        <td>@row.ClientType</td>
                        <td>@row.AccessMode</td>
                        <td>@row.JoinedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>@row.LastSeenAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td class="text-end">@row.ListenCount</td>
                        <td class="text-end">@row.TotalDurationSeconds</td>
                        <td>@(string.IsNullOrWhiteSpace(row.LastPoiName) ? "-" : row.LastPoiName)</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
