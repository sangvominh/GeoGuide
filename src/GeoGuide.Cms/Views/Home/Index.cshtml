@{
    ViewData["Title"] = "Dashboard";
}

<div class="p-4 p-md-5 mb-4 bg-light rounded-3 shadow-sm border-0" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
    <div class="container-fluid py-3">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
                <p class="text-uppercase fw-semibold text-primary mb-2" style="letter-spacing:.08em;">Reference implementation</p>
                <h1 class="display-6 fw-bold text-dark">GeoGuide CMS</h1>
                <p class="col-md-10 fs-5 text-muted">
                    Backend/CMS da duoc mo rong theo dap an tham khao: Content API, Localization, Audio/TTS, Maps offline manifest, Owner portal, RBAC va AI Advisor.
                </p>
            </div>
            <a class="btn btn-dark px-4 shadow-sm" href="/system-presentation-standalone.html" target="_blank" rel="noopener">
                Reference Presentation
            </a>
        </div>
        <div class="d-flex gap-2 flex-wrap mt-4">
            <a class="btn btn-primary px-4 shadow-sm" asp-controller="PoisAdmin" asp-action="Index">Quản lý POI</a>
            <a class="btn btn-outline-secondary px-4 shadow-sm" asp-controller="ToursAdmin" asp-action="Index">Quản lý Tour</a>
            <a class="btn btn-outline-secondary px-4 shadow-sm" asp-controller="AnalyticsAdmin" asp-action="Index">Analytics</a>
            <a class="btn btn-outline-info px-4 shadow-sm" href="/api/v1/poi/load-all?lang=en">Reference POI API</a>
            <a class="btn btn-outline-info px-4 shadow-sm" href="/api/v1/audio/voices">Audio API</a>
            <a class="btn btn-outline-info px-4 shadow-sm" href="/api/v1/maps/offline-manifest">Maps API</a>
        </div>
    </div>
</div>

<div class="row g-4 mt-2">
    <div class="col-lg-4 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="badge bg-success mb-3">Implemented</div>
                <h2 class="h5 fw-bold">User App / Mobile</h2>
                <p class="text-muted mb-2">MAUI app now supports reference startup APIs, nearby POIs, hotset preparation, on-demand localization, local cache and narration fallback.</p>
                <code>/api/v1/poi/load-all</code><br />
                <code>/api/v1/localizations/on-demand</code>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="badge bg-success mb-3">Implemented</div>
                <h2 class="h5 fw-bold">Admin CMS</h2>
                <p class="text-muted mb-2">Admin can manage POIs, tours, analytics and approve/reject owner-submitted POIs through added reference APIs.</p>
                <code>/api/v1/admin/auth/me</code><br />
                <code>/api/v1/admin/pois/{id}/approve</code>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="badge bg-success mb-3">Implemented</div>
                <h2 class="h5 fw-bold">Seller / Owner Portal</h2>
                <p class="text-muted mb-2">Owner registration and owner-scoped POI submission/update APIs were added. Owner POIs start pending and inactive.</p>
                <code>/api/v1/admin/auth/register-owner</code><br />
                <code>/api/v1/owner/pois</code>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="badge bg-primary mb-3">Reference API</div>
                <h2 class="h5 fw-bold">Localization + Audio</h2>
                <p class="text-muted mb-2">Hotset, warmup, on-demand translation fallback, voice catalog and TTS demo artifact endpoints are available.</p>
                <code>/api/v1/audio/tts</code><br />
                <code>/api/v1/localizations/warmup</code>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="badge bg-primary mb-3">Reference API</div>
                <h2 class="h5 fw-bold">Offline Maps</h2>
                <p class="text-muted mb-2">Map pack manifest and safe static serving routes for PMTiles/styles/fonts are ready. Real map assets are not committed.</p>
                <code>/api/v1/maps/offline-manifest</code>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="badge bg-primary mb-3">Reference API</div>
                <h2 class="h5 fw-bold">AI Advisor</h2>
                <p class="text-muted mb-2">Description enhancement endpoint exists with local-demo fallback and daily rate limit. Gemini can be configured later.</p>
                <code>/api/v1/ai/enhance-description</code>
            </div>
        </div>
    </div>
</div>
