@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="mb-4">
    <p class="text-uppercase text-muted fw-semibold mb-1" style="letter-spacing:.08em;">Admin workspace</p>
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <div>
            <h1 class="display-6 fw-bold mb-2">GeoGuide Admin</h1>
            <p class="text-muted fs-5 mb-0">
                Quan tri noi dung, duyet POI cua seller, tour va analytics. Seller va mobile la cac mat san pham rieng.
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary" asp-controller="PoisAdmin" asp-action="Index">Quan ly POI</a>
            <a class="btn btn-outline-danger" asp-controller="AdminReview" asp-action="Index">Duyet seller POI</a>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <span class="badge bg-dark mb-3">Admin</span>
                <h2 class="h5 fw-bold">Back Office</h2>
                <p class="text-muted">Quan tri POI, tour, noi dung da ngon ngu va dashboard analytics.</p>
                <div class="d-grid gap-2">
                    <a class="btn btn-outline-primary btn-sm" asp-controller="PoisAdmin" asp-action="Index">POI Admin</a>
                    <a class="btn btn-outline-primary btn-sm" asp-controller="ToursAdmin" asp-action="Index">Tour Admin</a>
                    <a class="btn btn-outline-primary btn-sm" asp-controller="AnalyticsAdmin" asp-action="Index">Analytics</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <span class="badge bg-danger mb-3">Review queue</span>
                <h2 class="h5 fw-bold">Seller Submissions</h2>
                <p class="text-muted">Seller gui quan/diem den len he thong, admin duyet roi moi hien tren mobile.</p>
                <div class="d-grid gap-2">
                    <a class="btn btn-outline-danger btn-sm" asp-controller="AdminReview" asp-action="Index">Mo hang doi duyet</a>
                    <a class="btn btn-outline-secondary btn-sm" asp-controller="OwnerPortal" asp-action="Index">Xem Seller Portal</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <span class="badge bg-success mb-3">Product tools</span>
                <h2 class="h5 fw-bold">Reference Workflows</h2>
                <p class="text-muted">Cong cu demo rieng cho AI, localization, TTS/audio va offline map manifest.</p>
                <div class="d-grid gap-2">
                    <a class="btn btn-outline-success btn-sm" asp-controller="AiAdvisor" asp-action="Index">AI Advisor</a>
                    <a class="btn btn-outline-success btn-sm" asp-controller="ReferenceConsole" asp-action="Index">Workflow Console</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h2 class="h5 fw-bold mb-3">Product Surfaces</h2>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Surface</th>
                                <th>Who uses it</th>
                                <th>Where</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Admin CMS</td>
                                <td>System admin</td>
                                <td><code>/</code>, <code>/PoisAdmin</code>, <code>/AdminReview</code></td>
                                <td><span class="badge bg-success">Visible UI</span></td>
                            </tr>
                            <tr>
                                <td>Seller Portal</td>
                                <td>Business owner / seller</td>
                                <td><code>/OwnerPortal</code></td>
                                <td><span class="badge bg-success">Visible UI</span></td>
                            </tr>
                            <tr>
                                <td>Mobile App</td>
                                <td>Tourist / end user</td>
                                <td><code>GeoGuide.Mobile.exe</code></td>
                                <td><span class="badge bg-success">Native app</span></td>
                            </tr>
                            <tr>
                                <td>Reference APIs</td>
                                <td>Mobile + demo tools</td>
                                <td><code>/api/v1/...</code></td>
                                <td><span class="badge bg-primary">Backend</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h2 class="h5 fw-bold mb-3">Quick Checks</h2>
                <div class="d-grid gap-2">
                    <a class="btn btn-outline-secondary btn-sm" href="/api/v1/poi/load-all?lang=en" target="_blank">POI feed</a>
                    <a class="btn btn-outline-secondary btn-sm" href="/api/v1/audio/voices" target="_blank">Audio voices</a>
                    <a class="btn btn-outline-secondary btn-sm" href="/api/v1/maps/offline-manifest" target="_blank">Maps manifest</a>
                </div>
            </div>
        </div>
    </div>
</div>
