@{
    ViewData["Title"] = "Dashboard";
}

<div class="p-4 p-md-5 mb-4 bg-light rounded-3">
    <div class="container-fluid py-3">
        <h1 class="display-6 fw-bold">GeoGuide CMS</h1>
        <p class="col-md-9 fs-5">
            Nen CMS da duoc tach 2 lop quyen: admin he thong quan ly toan bo va tenant chi quan ly du lieu POI nam trong pham vi duoc giao.
        </p>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary" asp-controller="PoisAdmin" asp-action="Index">Quan ly POI</a>
            <a class="btn btn-outline-secondary" href="/api/pois">GET /api/pois</a>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Phan quyen san sang</h2>
                <p class="mb-0">Role <code>SystemAdmin</code> xem va sua toan bo. Role <code>PoiTenant</code> dang nhap bang tai khoan rieng va chi thao tac tren POI thuoc tenant cua ho.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5">Bootstrap tai khoan</h2>
                <p class="mb-0">Khoi dong app se migrate database, seed tenant demo, role CMS va 2 tai khoan mac dinh de tiep tuc mo rong cac module audio, dich vu va noi dung theo tenant.</p>
            </div>
        </div>
    </div>
</div>
