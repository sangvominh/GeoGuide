@model GeoGuide.Cms.Models.Tour

@{
    ViewData["Title"] = "Sua Tour";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Sua Tour</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-controller="TourPoiMappingsAdmin" asp-action="Index" asp-route-tourId="@Model.Id">Gan POI</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Quay lai</a>
    </div>
</div>

<form asp-action="Edit" method="post" class="card shadow-sm p-4">
    <input asp-for="Id" type="hidden" />
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Cap nhat</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Huy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
