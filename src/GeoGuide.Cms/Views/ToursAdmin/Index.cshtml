@model GeoGuide.Cms.Models.ToursAdminIndexViewModel

@{
    ViewData["Title"] = "Tours";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Tour Management</h1>
        <p class="text-muted mb-0">Quan ly cac tuyen tham quan va nhom POI phuc vu mobile app.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Tao Tour</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>POIs</th>
                    <th>Status</th>
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tour in Model.Tours)
                {
                    <tr>
                        <td class="fw-semibold">@tour.Name</td>
                        <td>@tour.Description</td>
                        <td>@tour.PoiMappings.Count</td>
                        <td>
                            @if (tour.IsActive)
                            {
                                <span class="badge text-bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>@tour.UpdatedAt.ToUniversalTime().ToString("u")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="TourPoiMappingsAdmin" asp-action="Index" asp-route-tourId="@tour.Id">POIs</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@tour.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@tour.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
