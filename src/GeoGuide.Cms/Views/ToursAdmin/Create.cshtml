@model GeoGuide.Cms.Models.Tour

@{
    ViewData["Title"] = "Tao Tour";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Tao Tour</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Quay lai</a>
</div>

<form asp-action="Create" method="post" class="card shadow-sm p-4">
    <partial name="_Form" model="Model" />
    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Luu</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Huy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
