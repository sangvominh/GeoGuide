@model GeoGuide.Cms.Models.Tour

@{
    ViewData["Title"] = "Xoa Tour";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="h4 mb-3">Xoa Tour</h1>
        <p>Ban co chac chan muon xoa tour <strong>@Model.Name</strong> khong?</p>
        <form asp-action="Delete" method="post" class="d-flex gap-2">
            <input asp-for="Id" type="hidden" />
            <button type="submit" class="btn btn-danger">Xoa</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Huy</a>
        </form>
    </div>
</div>
